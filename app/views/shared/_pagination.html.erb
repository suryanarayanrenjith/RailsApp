<%# locals: (pagination:, query_params: {}) -%>
<% if pagination.multiple_pages? %>
  <nav class="pagination" aria-label="Pagination">
    <% if pagination.previous_page %>
      <%= link_to "← Newer", url_for(query_params.merge(page: pagination.previous_page)), class: "button button-secondary", rel: "prev" %>
    <% else %>
      <span class="button button-secondary" aria-disabled="true">← Newer</span>
    <% end %>

    <span class="pagination-status">Page <%= pagination.page %> of <%= pagination.total_pages %></span>

    <% if pagination.next_page %>
      <%= link_to "Older →", url_for(query_params.merge(page: pagination.next_page)), class: "button button-secondary", rel: "next" %>
    <% else %>
      <span class="button button-secondary" aria-disabled="true">Older →</span>
    <% end %>
  </nav>
<% end %>
