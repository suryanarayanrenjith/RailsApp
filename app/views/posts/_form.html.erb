<%= form_with model: post, class: "form" do |form| %>
  <div class="field" data-controller="character-counter">
    <%= form.label :title %>
    <%= form.text_field :title, required: true, maxlength: 150, autofocus: post.new_record?,
          placeholder: "Give your post a clear title",
          data: { character_counter_target: "input", action: "character-counter#update" } %>
    <div class="field-footer">
      <%= form.error_message :title %>
      <span class="counter" data-character-counter-target="counter"></span>
    </div>
  </div>

  <div class="field">
    <%= form.label :body %>
    <%= form.text_area :body, rows: 14, required: true, maxlength: 20_000,
          placeholder: "What’s on your mind?", aria: { describedby: "post_body_hint" } %>
    <p id="post_body_hint" class="hint">Plain text. Leave a blank line between paragraphs.</p>
    <%= form.error_message :body %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "button button-primary" %>
    <%= link_to "Cancel", post.persisted? ? post_path(post) : posts_path, class: "button button-ghost" %>
  </div>
<% end %>
