<% content_for :title, @query.present? ? "Search: #{@query}" : "Latest posts" %>

<section class="page-header">
  <h1><%= @query.present? ? "Search results" : "Latest posts" %></h1>
  <p class="lead">Stories, notes, and ideas from the community.</p>
</section>

<%= form_with url: posts_path, method: :get, class: "search-form", role: "search" do |form| %>
  <%= form.label :query, "Search posts", class: "visually-hidden" %>
  <%= form.search_field :query, value: @query, placeholder: "Search posts…", autocomplete: "off" %>
  <%= form.submit "Search", name: nil, class: "button button-secondary" %>
<% end %>

<% if @query.present? %>
  <p class="search-summary">
    <%= pluralize(@pagination.total_count, "result") %> for “<%= @query %>” ·
    <%= link_to "Clear search", posts_path %>
  </p>
<% end %>

<div id="posts" class="post-list">
  <%= render(@posts) || render("posts/empty", query: @query) %>
</div>

<%= render "shared/pagination", pagination: @pagination, query_params: { query: @query.presence }.compact %>
