<% content_for :title, @post.title %>
<% content_for :description, excerpt(@post, length: 160) %>

<article id="<%= dom_id @post %>" class="post">
  <header class="post-header">
    <p class="back-link"><%= link_to "← All posts", posts_path %></p>
    <h1 class="post-title"><%= @post.title %></h1>
    <%= render "posts/meta", post: @post %>
    <% if @post.updated_at > @post.created_at + 1.minute %>
      <p class="post-edited">Updated <%= time_ago_tag @post.updated_at %></p>
    <% end %>
  </header>

  <div class="post-body">
    <%= format_plain_text @post.body %>
  </div>

  <% if @post.authored_by?(Current.user) %>
    <footer class="post-actions">
      <%= link_to "Edit post", edit_post_path(@post), class: "button button-secondary" %>
      <%= button_to "Delete post", @post, method: :delete, class: "button button-danger",
            form: { data: { turbo_confirm: "Delete “#{@post.title}”? This can’t be undone." } } %>
    </footer>
  <% end %>
</article>

<%= render "comments/section", post: @post, comments: @comments, comment: @comment %>
