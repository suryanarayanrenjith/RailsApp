<% content_for :title, "Choose a new password" %>

<div class="auth">
  <div class="card auth-card">
    <h1>Choose a new password</h1>
    <p class="muted">You’ll be signed out everywhere and can then sign in with your new password.</p>

    <%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
      <div class="field">
        <%= form.label :password, "New password" %>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
              minlength: User::MINIMUM_PASSWORD_LENGTH, maxlength: 72, aria: { describedby: "password_hint" } %>
        <p id="password_hint" class="hint">At least <%= User::MINIMUM_PASSWORD_LENGTH %> characters.</p>
      </div>

      <div class="field">
        <%= form.label :password_confirmation, "Confirm new password" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </div>

      <% if @user.errors.any? %>
        <div class="form-errors" role="alert">
          <p><%= @user.errors.full_messages.to_sentence %>.</p>
        </div>
      <% end %>

      <%= form.submit "Save new password", class: "button button-primary button-block" %>
    <% end %>
  </div>
</div>
